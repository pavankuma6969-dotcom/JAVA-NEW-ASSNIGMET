#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;

    while (T--) {
        int N, M;
        cin >> N >> M;

        set<string> groups;

        for (int i = 0; i < N; i++) {
            string s;
            cin >> s;
            sort(s.begin(), s.end());
            groups.insert(s);
        }

        cout << groups.size() << '\n';
    }

    return 0;
}
